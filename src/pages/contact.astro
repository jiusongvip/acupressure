---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact Us" description="Get in touch with the Acupressure Guide team. Send questions, feedback, or suggestions about our acupressure guides and resources." breadcrumbs={[{ label: "Home", href: "/" }, { label: "Contact", href: "/contact" }]} schema={{"@context":"https://schema.org","@type":"ContactPoint","contactType":"customer support","email":"hello@acupressureguide.com","url":"https://www.acupressureguide.com/contact","availableLanguage":"English"}}>
<div class="max-w-2xl mx-auto px-4 py-12 lg:px-6"><h1 class="mb-4">Contact</h1><p class="text-stone-500 dark:text-stone-400 text-lg mb-8">Have a question, suggestion, or feedback? We'd love to hear from you.</p><p class="text-stone-600 dark:text-stone-300 mb-4">For general inquiries, reach out to us at:</p><p class="text-stone-700 dark:text-stone-200 font-medium"><a href="mailto:hello@acupressureguide.com" class="text-emerald-600 dark:text-emerald-400 hover:underline">hello@acupressureguide.com</a></p><hr class="my-8 border-stone-200 dark:border-stone-700"><p class="text-sm text-stone-500 dark:text-stone-400">If you have a medical question, please consult a qualified healthcare professional. We cannot provide individual health advice.</p></div>
</BaseLayout>

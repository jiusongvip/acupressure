---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Body Atlas – Interactive Acupressure Points Map" description="Explore acupressure points through our interactive body atlas. Click any body region to discover pressure points with detailed location guides.">
<div class="max-w-6xl mx-auto px-4 py-12 lg:px-6"><div class="text-center mb-10"><h1 class="text-3xl md:text-4xl font-bold tracking-tight text-stone-900 dark:text-stone-100 mb-3">Body Atlas</h1><p class="text-stone-500 dark:text-stone-400 text-lg max-w-xl mx-auto">Explore acupressure points by body region. Click any part of the body to discover pressure points, their locations, and how to use them.</p></div><!-- Search --><div class="max-w-md mx-auto mb-10"><div class="relative"><svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg><input type="text" id="point-search" placeholder="Search a point (e.g. LI4, headache, anxiety...)" class="w-full pl-10 pr-4 py-3 rounded-xl border border-stone-200 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:border-transparent dark:border-stone-700 dark:bg-stone-800 dark:text-stone-200 dark:placeholder-stone-500"></div><div id="search-results" class="hidden mt-2 rounded-xl border border-stone-200 bg-white shadow-lg dark:border-stone-700 dark:bg-stone-800 overflow-hidden"></div></div><!-- Interactive Body Map --><div class="flex justify-center mb-12"><div class="relative" id="body-map"><svg width="360" height="620" viewBox="0 0 360 620" xmlns="http://www.w3.org/2000/svg" class="w-[280px] md:w-[360px]"><defs><radialGradient id="glow" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="rgba(45,106,79,0.15)"></stop><stop offset="100%" stop-color="rgba(45,106,79,0)"></stop></radialGradient></defs><!-- Head --><g class="body-region" data-region="Head" data-url="/body/head-acupressure-points/"><ellipse cx="180" cy="48" rx="44" ry="48" fill="rgba(45,106,79,0.06)" stroke="#2d6a4f" stroke-width="1.5" class="region-shape"></ellipse><text x="180" y="42" class="region-label" font-family="system-ui" font-size="11" fill="#2d6a4f" font-weight="600" text-anchor="middle">Head</text></g><!-- Face --><g class="body-region" data-region="Face" data-url="/body/face-acupressure-points/"><ellipse cx="180" cy="70" rx="34" ry="22" fill="rgba(45,106,79,0.06)" stroke="#2d6a4f" stroke-width="1" class="region-shape"></ellipse><text x="180" y="74" class="region-label" font-family="system-ui" font-size="9" fill="#2d6a4f" font-weight="500" text-anchor="middle">Face</text></g><!-- Ear (left+right) --><g class="body-region" data-region="Ear" data-url="/body/ear-acupressure-points/"><ellipse cx="132" cy="60" rx="10" ry="14" fill="rgba(45,106,79,0.06)" stroke="#2d6a4f" stroke-width="1" class="region-shape"></ellipse><ellipse cx="228" cy="60" rx="10" ry="14" fill="rgba(45,106,79,0.06)" stroke="#2d6a4f" stroke-width="1" class="region-shape"></ellipse></g><!-- Neck --><g class="body-region" data-region="Neck" data-url="/body/neck-acupressure-points/"><rect x="165" y="92" width="30" height="30" rx="5" fill="rgba(45,106,79,0.06)" stroke="#2d6a4f" stroke-width="1" class="region-shape"></rect><text x="180" y="112" class="region-label" font-family="system-ui" font-size="9" fill="#2d6a4f" font-weight="500" text-anchor="middle">Neck</text></g><!-- Shoulders --><g class="body-region" data-region="Shoulder" data-url="/body/shoulder-acupressure-points/"><path d="M100 122 C85 120, 55 124, 45 134 C40 139, 38 148, 42 155 L60 155 C65 145, 85 138, 105 138 Z" fill="rgba(45,106,79,0.06)" stroke="#2d6a4f" stroke-width="1" class="region-shape"></path><path d="M260 122 C275 120, 305 124, 315 134 C320 139, 322 148, 318 155 L300 155 C295 145, 275 138, 255 138 Z" fill="rgba(45,106,79,0.06)" stroke="#2d6a4f" stroke-width="1" class="region-shape"></path><text x="73" y="137" class="region-label" font-family="system-ui" font-size="8" fill="#2d6a4f" font-weight="500" text-anchor="middle">Shoulder</text><text x="287" y="137" class="region-label" font-family="system-ui" font-size="8" fill="#2d6a4f" font-weight="500" text-anchor
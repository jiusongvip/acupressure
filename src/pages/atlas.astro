 fill="#2d6a4f" font-weight="500" text-anchor="middle">Leg</text></g><!-- Left Foot --><g class="body-region" data-region="Foot" data-url="/body/foot-acupressure-points/"><rect x="122" y="525" width="48" height="24" rx="8" fill="rgba(45,106,79,0.06)" stroke="#2d6a4f" stroke-width="1" class="region-shape"></rect><text x="146" y="541" class="region-label" font-family="system-ui" font-size="9" fill="#2d6a4f" font-weight="500" text-anchor="middle">Foot</text></g><!-- Right Foot --><g class="body-region" data-region="Foot" data-url="/body/foot-acupressure-points/"><rect x="190" y="525" width="48" height="24" rx="8" fill="rgba(45,106,79,0.06)" stroke="#2d6a4f" stroke-width="1" class="region-shape"></rect><text x="214" y="541" class="region-label" font-family="system-ui" font-size="9" fill="#2d6a4f" font-weight="500" text-anchor="middle">Foot</text></g><!-- Point dots --><circle cx="180" cy="38" r="2.5" fill="#2d6a4f" opacity="0.5"></circle><circle cx="180" cy="145" r="2.5" fill="#2d6a4f" opacity="0.5"></circle><circle cx="155" cy="235" r="2.5" fill="#2d6a4f" opacity="0.5"></circle><circle cx="205" cy="235" r="2.5" fill="#2d6a4f" opacity="0.5"></circle><circle cx="180" cy="295" r="2.5" fill="#2d6a4f" opacity="0.5"></circle><circle cx="38" cy="240" r="2.5" fill="#2d6a4f" opacity="0.5"></circle><circle cx="322" cy="240" r="2.5" fill="#2d6a4f" opacity="0.5"></circle><circle cx="148" cy="400" r="2.5" fill="#2d6a4f" opacity="0.5"></circle><circle cx="212" cy="400" r="2.5" fill="#2d6a4f" opacity="0.5"></circle><circle cx="148" cy="480" r="2.5" fill="#2d6a4f" opacity="0.5"></circle><circle cx="212" cy="480" r="2.5" fill="#2d6a4f" opacity="0.5"></circle></svg><!-- Hover tooltip --><div id="region-tooltip" class="absolute top-0 left-1/2 -translate-x-1/2 -mt-6 px-3 py-1.5 rounded-lg bg-emerald-700 text-white text-xs font-medium shadow-lg opacity-0 transition-opacity pointer-events-none whitespace-nowrap">Head</div></div></div><!-- Quick Region Links --><div class="max-w-2xl mx-auto 
---
import BaseLayout from "../../layouts/BaseLayout.astro";

const regions = [
  { key: "head", name: "Head", bodyUrl: "/body/head-acupressure-points/", blurb: "Tension headaches, migraines, pressure, dizziness, mental fatigue", causes: ["Tension or stress headaches", "Migraine (with or without aura)", "Sinus congestion and pressure", "Eye strain and screen fatigue", "Feeling heavy-headed after long days"], redFlags: ["Sudden, severe \"worst-ever\" headache", "Headache with fever and a stiff neck", "Headache after a recent head injury", "Sudden weakness, numbness, or trouble speaking"], points: [{ code: "GV20", name: "Baihui", use: "Headaches, dizziness, mental fatigue", url: "/points/gv20-baihui-acupressure-point/" }, { code: "GB20", name: "Fengchi", use: "Headaches, neck tension, sinus relief", url: "/points/gb20-fengchi-acupressure-point/" }, { code: "Yintang", name: "Third Eye Point", use: "Stress, headaches, mental clarity", url: "/points/yintang-acupressure-point/" }, { code: "Taiyang", name: "Solar Plexus Temples", use: "Headaches, eye strain", url: "/points/taiyang-acupressure-point/" }], conditions: [{ label: "Headache relief guide", url: "/conditions/acupressure-for-headache/" }, { label: "Migraine relief guide", url: "/conditions/acupressure-for-migraine/" }] },
  { key: "face", name: "Face", bodyUrl: "/body/face-acupressure-points/", blurb: "Sinus pressure, jaw tension, facial puffiness", causes: ["Sinus congestion and pressure", "Facial tension from stress or jaw clenching", "Nasal congestion and stuffiness", "Puffiness or dull complexion"], redFlags: ["Facial pain with high fever and swelling", "One-sided facial droop or weakness", "Eye pain with vision changes"], points: [{ code: "LI20", name: "Yingxiang", use: "Nasal congestion, sinus pressure", url: "/points/li20-yingxiang-acupressure-point/" }, { code: "Yintang", name: "Third Eye Point", use: "Sinuses, stress, headaches", url: "/points/yintang-acupressure-point/" }, { code: "Taiyang", name: "Solar Plexus Temples", use: "Facial tension, headaches", url: "/points/taiyang-acupressure-point/" }], conditions: [{ label: "Headache relief guide", url: "/conditions/acupressure-for-headache/" }] },
  { key: "ear", name: "Ear", bodyUrl: "/body/ear-acupressure-points/", blurb: "Motion sickness, travel queasiness, stress", causes: ["Motion sickness and travel nausea", "Stress and travel anxiety", "Ear pressure on flights or elevation changes"], redFlags: ["Sudden hearing loss", "Ear pain with fever and discharge", "Ringing in the ears (tinnitus) that is new or one-sided"], points: [], conditions: [{ label: "Nausea relief guide", url: "/conditions/acupressure-for-nausea/" }], note: "Ear acupressure uses tiny press pellets or gentle rubbing of the whole ear. See the full ear region guide for technique." },
  { key: "neck", name: "Neck", bodyUrl: "/body/neck-acupressure-points/", blurb: "Stiffness, tension headaches, restricted mobility", causes: ["Neck stiffness and tension", "Tension headaches that start at the base of the skull", "Posture strain from screens and desks", "Restricted range of motion"], redFlags: ["Neck pain with fever and severe headache", "Neck pain after a fall or whiplash", "Numbness or weakness spreading into the arms or hands"], points: [{ code: "GB20", name: "Fengchi", use: "Neck tension, headaches", url: "/points/gb20-fengchi-acupressure-point/" }, { code: "GB21", name: "Jianjing", use: "Shoulder and neck tension", url: "/points/gb21-jianjing-acupressure-point/" }, { code: "BL10", name: "Tianzhu", use: "Neck stiffness, headaches", url: "/points/bl10-tianzhu-acupressure-point/" }], conditions: [{ label: "Neck pain relief guide", url: "/conditions/acupressure-for-neck-pain/" }, { label: "Headache relief guide", url: "/conditions/acupressure-for-headache/" }] },
  { key: "shoulder", name: "Shoulder", bodyUrl: "/body/shoulder-acupressure-points/", blurb: "Tension, stiffness, frozen shoulder, referred neck pain", causes: ["Shoulder tension from desk work and stress", "Stiffness and reduced range of motion", "Referred pain from the neck", "Overuse strain"], redFlags: ["Shoulder pain with chest pain, sweating, or shortness of breath", "Inability to raise the arm after an injury", "Severe pain or swelling after a fall"], points: [{ code: "GB21", name: "Jianjing", use: "Shoulder tension, stress", url: "/points/gb21-jianjing-acupressure-point/" }, { code: "LI15", name: "Jianyu", use: "Shoulder pain, stiffness", url: "/points/li15-jianyu-acupressure-point/" }, { code: "SI9", name: "Jianzhen", use: "Shoulder and upper back pain", url: "/points/si9-jianzhen-acupressure-point/" }], conditions: [{ label: "Neck pain relief guide", url: "/conditions/acupressure-for-neck-pain/" }, { label: "Back pain relief guide", url: "/conditions/acupressure-for-back-pain/" }] },
  { key: "chest", name: "Chest", bodyUrl: "/body/chest-acupressure-points/", blurb: "Tightness, anxiety, shallow breathing, congestion", causes: ["Anxiety and stress tightness", "Shallow or congested breathing", "Cough and chest congestion", "Feeling emotionally weighed down"], redFlags: ["Chest pain with sweating, shortness of breath, or pain in the jaw or arm — seek emergency care", "Chest pain after an injury", "Coughing up blood"], points: [{ code: "CV17", name: "Shanzhong", use: "Chest tightness, anxiety, breathing", url: "/points/cv17-shanzhong-acupressure-point/" }, { code: "CV22", name: "Tiantu", use: "Cough, sore throat, breathing", url: "/points/cv22-tiantu-acupressure-point/" }, { code: "LU1", name: "Zhongfu", use: "Cough, chest and shoulder tension", url: "/points/lu1-zhongfu-acupressure-point/" }], conditions: [{ label: "Anxiety relief guide", url: "/conditions/acupressure-for-anxiety/" }, { label: "Nausea relief guide", url: "/conditions/acupressure-for-nausea/" }] },
  { key: "abdomen", name: "Abdomen", bodyUrl: "/body/abdomen-acupressure-points/", blurb: "Bloating, constipation, cramping, indigestion", causes: ["Constipation and sluggish bowels", "Bloating and gas", "Indigestion and feeling full after meals", "Menstrual cramping and lower abdominal coldness"], redFlags: ["Sudden, severe, or worsening abdominal pain", "Abdominal pain with fever or vomiting", "Blood in the stool", "Pregnancy — avoid abdomen pressure points entirely"], points: [{ code: "ST25", name: "Tianshu", use: "Constipation, bloating, cramping", url: "/points/st25-tianshu-acupressure-point/" }, { code: "CV12", name: "Zhongwan", use: "Indigestion, nausea, fullness", url: "/points/cv12-zhongwan-acupressure-point/" }, { code: "CV6", name: "Qihai", use: "Fatigue, digestion, cold abdomen", url: "/points/cv6-qihai-acupressure-point/" }, { code: "CV4", name: "Guanyuan", use: "Menstrual cramps, lower abdomen cold", url: "/points/cv4-guanyuan-acupressure-point/" }], conditions: [{ label: "Constipation relief guide", url: "/conditions/acupressure-for-constipation/" }, { label: "Nausea relief guide", url: "/conditions/acupressure-for-nausea/" }] },
  { key: "back", name: "Back", bodyUrl: "/body/back-acupressure-points/", blurb: "Low back pain, muscle strain, sciatica-like pain", causes: ["Low back pain and muscle strain", "Upper back tension", "Sciatica-like pain radiating down the leg", "Cold, achy, or tired back"], redFlags: ["Back pain with fever", "Back pain after a fall or accident", "Loss of bladder or bowel control, or numbness in the groin area", "Progressive leg weakness"], points: [{ code: "BL23", name: "Shenshu", use: "Low back pain, fatigue, kidney support", url: "/points/bl23-shenshu-acupressure-point/" }, { code: "BL40", name: "Weizhong", use: "Low back pain, sciatica", url: "/points/bl40-weizhong-acupressure-point/" }, { code: "BL13", name: "Feishu", use: "Upper back, cough, congestion", url: "/points/bl13-feishu-acupressure-point/" }, { code: "GV14", name: "Dazhui", use: "Neck-back junction, immunity", url: "/points/gv14-dazhui-acupressure-point/" }], conditions: [{ label: "Back pain relief guide", url: "/conditions/acupressure-for-back-pain/" }, { label: "Sleep quality guide", url: "/conditions/acupressure-for-sleep/" }] },
  { key: "arm", name: "Arm & Wrist", bodyUrl: "/body/arm-wrist-acupressure-points/", blurb: "Wrist strain, nausea, motion sickness, elbow tension", causes: ["Wrist and forearm strain", "Motion sickness and nausea", "Elbow and forearm tension", "Travel queasiness"], redFlags: ["Wrist pain after an injury with swelling", "Sudden arm weakness", "Progressive numbness or tingling in the hand"], points: [{ code: "PC6", name: "Neiguan", use: "Nausea, motion sickness, anxiety", url: "/points/pc6-neiguan-acupressure-point/" }, { code: "LI4", name: "Hegu", use: "Headaches, pain relief, immunity", url: "/points/li4-hegu-acupressure-point/" }, { code: "LU7", name: "Lieque", use: "Cough, nasal congestion, headaches", url: "/points/lu7-lieque-acupressure-point/" }, { code: "LI11", name: "Quchi", use: "Skin irritation, immunity, fever", url: "/points/li11-quchi-acupressure-point/" }], conditions: [{ label: "Nausea relief guide", url: "/conditions/acupressure-for-nausea/" }, { label: "Headache relief guide", url: "/conditions/acupressure-for-headache/" }] },
  { key: "hand", name: "Hand", bodyUrl: "/body/hand-acupressure-chart/", blurb: "Headaches, nausea, stress — the fastest points to reach", causes: ["Headache and facial pain trigger points", "Nausea and motion sickness", "Stress and racing thoughts", "Nighttime wakefulness"], redFlags: ["Severe or persistent hand pain", "Hand pain with swelling after an injury", "Pins-and-needles that will not go away"], points: [{ code: "LI4", name: "Hegu", use: "Headaches, pain relief, immunity", url: "/points/li4-hegu-acupressure-point/" }, { code: "HT7", name: "Shenmen", use: "Sleep, anxiety, heart calming", url: "/points/ht7-shenmen-acupressure-point/" }], conditions: [{ label: "Headache relief guide", url: "/conditions/acupressure-for-headache/" }, { label: "Sleep quality guide", url: "/conditions/acupressure-for-sleep/" }, { label: "Anxiety relief guide", url: "/conditions/acupressure-for-anxiety/" }, { label: "Nausea relief guide", url: "/conditions/acupressure-for-nausea/" }] },
  { key: "leg", name: "Leg", bodyUrl: "/body/leg-acupressure-points/", blurb: "Knee strain, leg fatigue, menstrual cramping", causes: ["Knee and leg strain", "Heavy, tired legs", "Menstrual cramping", "Digestive sluggishness"], redFlags: ["Leg pain with swelling, redness, and warmth", "Inability to bear weight after an injury", "Sudden, severe calf pain"], points: [{ code: "ST36", name: "Zusanli", use: "Digestion, energy, immunity", url: "/points/st36-zusanli-acupressure-point/" }, { code: "SP6", name: "Sanyinjiao", use: "Menstrual cramps, sleep, digestion", url: "/points/sp6-sanyinjiao-acupressure-point/" }, { code: "GB34", name: "Yanglingquan", use: "Joints, tendons, muscle tension", url: "/points/gb34-yanglingquan-acupressure-point/" }, { code: "LV3", name: "Taichong", use: "Stress, headaches, menstrual issues", url: "/points/lv3-taichong-acupressure-point/" }], conditions: [{ label: "Sleep quality guide", url: "/conditions/acupressure-for-sleep/" }, { label: "Back pain relief guide", url: "/conditions/acupressure-for-back-pain/" }] },
  { key: "foot", name: "Foot", bodyUrl: "/body/foot-acupressure-points/", blurb: "Fatigue, grounding, stress, headaches from below", causes: ["Tired, heavy feet at the end of the day", "Stress and racing thoughts", "Headaches and tension", "Feeling ungrounded or wired"], redFlags: ["Foot pain with swelling and redness after an injury", "New numbness or tingling (especially with diabetes)", "Open sores or slow-healing wounds on the feet"], points: [{ code: "KI1", name: "Yongquan", use: "Anxiety, sleep, grounding energy", url: "/points/ki1-yongquan-acupressure-point/" }, { code: "LV3", name: "Taichong", use: "Stress, headaches, blood pressure", url: "/points/lv3-taichong-acupressure-point/" }, { code: "BL60", name: "Kunlun", use: "Back, neck, and ankle pain", url: "/points/bl60-kunlun-acupressure-point/" }, { code: "KD3", name: "Taixi", use: "Fatigue, sleep, low back", url: "/points/kd3-taixi-acupressure-point/" }], conditions: [{ label: "Sleep quality guide", url: "/conditions/acupressure-for-sleep/" }, { label: "Headache relief guide", url: "/conditions/acupressure-for-headache/" }] }
];

const regionByKey = Object.fromEntries(regions.map(r => [r.key, r]));
function panelFor(region) {
  const pts = (region.points || []).map(p => `
        <a href="${p.url}" class="group flex items-center gap-3 rounded-lg border border-stone-200 bg-white p-3 transition-all hover:border-emerald-400 hover:shadow-sm dark:border-stone-700 dark:bg-stone-900 dark:hover:border-emerald-600">
          <span class="shrink-0 w-10 h-10 rounded-md bg-emerald-100 dark:bg-emerald-900/40 flex items-center justify-center text-emerald-700 dark:text-emerald-400 text-xs font-bold">${p.code}</span>
          <span class="min-w-0">
            <span class="block text-sm font-semibold text-stone-900 dark:text-stone-100">${p.name}</span>
            <span class="block text-xs text-stone-500 dark:text-stone-400 truncate">${p.use}</span>
          </span>
        </a>`).join("");
  const conds = (region.conditions || []).map(c => `<a href="${c.url}" class="inline-flex items-center gap-1 text-sm font-medium text-emerald-700 hover:text-emerald-600 dark:text-emerald-400 dark:hover:text-emerald-300 transition-colors">${c.label} →</a>`).join(" &nbsp;·&nbsp; ");
  const note = region.note ? `<p class="mt-3 text-sm text-stone-500 dark:text-stone-400 leading-relaxed">${region.note}</p>` : "";
  return `<article data-region-panel="${region.key}" class="hidden">
      <div class="flex items-start justify-between gap-3 mb-4">
        <div>
          <h2 class="text-xl font-bold tracking-tight text-stone-900 dark:text-stone-100">${region.name}</h2>
          <p class="text-sm text-stone-500 dark:text-stone-400 mt-1">${region.blurb}</p>
        </div>
        <a href="${region.bodyUrl}" class="shrink-0 inline-flex items-center gap-1 rounded-lg border border-emerald-600 px-3 py-1.5 text-xs font-medium text-emerald-700 transition-colors hover:bg-emerald-50 dark:text-emerald-400 dark:hover:bg-emerald-900/20">Full region guide →</a>
      </div>
      <div class="space-y-4">
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-widest text-stone-400 mb-2">Common causes &amp; what it feels like</h3>
          <ul class="space-y-1.5 text-sm text-stone-600 dark:text-stone-300">
            ${region.causes.map(c => `<li class="flex gap-2"><span class="text-emerald-600 dark:text-emerald-400">•</span>${c}</li>`).join("")}
          </ul>
        </div>
        <div class="rounded-lg border border-red-200 bg-red-50 p-4 dark:border-red-900/40 dark:bg-red-950/30">
          <h3 class="text-xs font-semibold uppercase tracking-widest text-red-600 dark:text-red-400 mb-2">See a doctor if</h3>
          <ul class="space-y-1.5 text-sm text-red-700 dark:text-red-300">
            ${region.redFlags.map(f => `<li class="flex gap-2"><span aria-hidden="true">⚠</span>${f}</li>`).join("")}
          </ul>
        </div>
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-widest text-stone-400 mb-2">Acupressure points for this region</h3>
          <div class="grid gap-2">${pts || `<p class="text-sm text-stone-500 dark:text-stone-400">${region.note || "No dedicated point page yet."}</p>`}</div>
        </div>
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-widest text-stone-400 mb-2">Condition guides</h3>
          <p class="text-sm">${conds || "—"}</p>
        </div>
      </div>
    </article>`;
}
const panelsHtml = regions.map(panelFor).join("");
---
<BaseLayout title="Where Does It Hurt? Interactive Pain Map" description="Interactive acupressure pain map. Click a body region for common causes, red-flag symptoms, and the best acupressure points and condition guides for that area." breadcrumbs={[{ label: "Home", href: "/" }, { label: "Pain Map", href: "/tools/pain-map/" }]} datePublished="2026-08-19" dateModified="2026-08-19" articleSchema={true}>
<div class="max-w-6xl mx-auto px-4 py-12 lg:px-6">
  <div class="text-center mb-10">
    <span class="text-xs font-semibold uppercase tracking-widest text-emerald-600 dark:text-emerald-400">Interactive Tool</span>
    <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-stone-900 dark:text-stone-100 mt-2 mb-3">Where Does It Hurt?</h1>
    <p class="text-stone-500 dark:text-stone-400 text-lg max-w-2xl mx-auto">Click a region on the body to see the most common causes of pain there, the red-flag symptoms that mean you should see a doctor first, and the best acupressure points and guides to try. Built as a starting point — not a diagnosis.</p>

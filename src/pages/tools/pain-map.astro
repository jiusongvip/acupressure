            <text x="180" y="232" font-family="system-ui" font-size="10" fill="#2d6a4f" font-weight="500" text-anchor="middle">Arm</text>
          </g>
          <g class="region" data-region="hand" tabindex="0" role="button" aria-label="Hand region">
            <rect x="18" y="275" width="40" height="28" rx="6" fill="rgba(45,106,79,0.10)" stroke="#2d6a4f" stroke-width="1"></rect>
            <text x="38" y="293" font-family="system-ui" font-size="9" fill="#2d6a4f" font-weight="500" text-anchor="middle">Hand</text>

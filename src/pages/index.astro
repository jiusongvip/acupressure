---
import BaseLayout from "../layouts/BaseLayout.astro";

const points = [
  { code: "LI4", name: "Hegu", region: "Hand", img: "/images/li4-location.webp", alt: "LI4 Hegu acupressure point on the hand", url: "/points/li4-hegu-acupressure-point", location: "Web between thumb and index finger", tags: ["Pain relief", "Headache", "Sinus"] },
  { code: "PC6", name: "Neiguan", region: "Arm", img: "/images/pc6-location.webp", alt: "PC6 Neiguan acupressure point on the inner forearm", url: "/points/pc6-neiguan-acupressure-point", location: "Inner forearm, three finger-widths below the wrist crease", tags: ["Nausea", "Anxiety", "Motion sickness"] },
  { code: "ST36", name: "Zusanli", region: "Leg", img: "/images/st36-location.webp", alt: "ST36 Zusanli acupressure point below the knee", url: "/points/st36-zusanli-acupressure-point", location: "Four finger-widths below the kneecap, beside the shin bone", tags: ["Digestion", "Energy", "Immunity"] },
  { code: "SP6", name: "Sanyinjiao", region: "Leg", img: "/images/sp6-location.webp", alt: "SP6 Sanyinjiao acupressure point on the inner lower leg", url: "/points/sp6-sanyinjiao-acupressure-point", location: "Inner lower leg, four finger-widths above the inner ankle", tags: ["Women's health", "Sleep", "Circulation"] },
  { code: "GB20", name: "Fengchi", region: "Neck", img: "/images/gb20-location.webp", alt: "GB20 Fengchi acupressure point at the base of the skull", url: "/points/gb20-fengchi-acupressure-point", location: "Hollows at the base of the skull", tags: ["Headache", "Neck tension", "Sinuses"] },
  { code: "HT7", name: "Shenmen", region: "Wrist", img: "/images/ht7-location.webp", alt: "HT7 Shenmen acupressure point on the wrist", url: "/points/ht7-shenmen-acupressure-point", location: "Inner wrist crease, in line with the little finger", tags: ["Insomnia", "Anxiety", "Heart calm"] },
  { code: "LV3", name: "Taichong", region: "Foot", img: "/images/lv3-location.webp", alt: "LV3 Taichong acupressure point on the top of the foot", url: "/points/lv3-taichong-acupressure-point", location: "Top of the foot, between the first and second toe bones", tags: ["Stress", "Headache", "Liver qi"] },
  { code: "Yintang", name: "Hall of Impression", region: "Face", img: "/images/yintang-location.webp", alt: "Yintang acupressure point between the eyebrows", url: "/points/yintang-acupressure-point", location: "Midway between the eyebrows", tags: ["Anxiety", "Stress", "Clear thinking"] },
  { code: "BL40", name: "Weizhong", region: "Leg", img: "/images/bl40-location.webp", alt: "BL40 Weizhong acupressure point behind the knee", url: "/points/bl40-weizhong-acupressure-point", location: "Center of the crease behind the knee", tags: ["Back pain", "Sciatica", "Knee pain"] },
  { code: "BL60", name: "Kunlun", region: "Ankle", img: "/images/bl60-location.webp", alt: "BL60 Kunlun acupressure point by the outer ankle", url: "/points/bl60-kunlun-acupressure-point", location: "Between the outer ankle bone and Achilles tendon", tags: ["Leg pain", "Headache", "Ankle pain"] },
  { code: "CV17", name: "Shanzhong", region: "Chest", img: "/images/cv17-location.webp", alt: "CV17 Shanzhong acupressure point on the chest", url: "/points/cv17-shanzhong-acupressure-point", location: "Center of the sternum at the nipple line", tags: ["Breathing", "Emotional release", "Chest tightness"] },
  { code: "CV6", name: "Qihai", region: "Abdomen", img: "/images/cv6-location.webp", alt: "CV6 Qihai acupressure point on the lower abdomen", url: "/points/cv6-qihai-acupressure-point", location: "Midline, two finger-widths below the navel", tags: ["Vitality", "Digestion", "Fatigue"] },
  { code: "GB21", name: "Jianjing", region: "Shoulder", img: "/images/gb21-location.webp", alt: "GB21 Jianjing acupressure point on the shoulder", url: "/points/gb21-jianjing-acupressure-point", location: "Highest point of the shoulder", tags: ["Shoulder tension", "Neck pain", "Stiffness"] },
  { code: "KD3", name: "Taixi", region: "Ankle", img: "/images/kd3-location.webp", alt: "KD3 Taixi acupressure point by the inner ankle", url: "/points/kd3-taixi-acupressure-point", location: "Between the inner ankle bone and Achilles tendon", tags: ["Kidney energy", "Fatigue", "Low back pain"] },
  { code: "KI1", name: "Yongquan", region: "Foot", img: "/images/ki1-location.webp", alt: "KI1 Yongquan acupressure point on the sole of the foot", url: "/points/ki1-yongquan-acupressure-point", location: "Sole of the foot, where a crease forms when toes curl", tags: ["Calming", "Grounding", "Insomnia"] },
  { code: "LI11", name: "Quchi", region: "Arm", img: "/images/li11-location.webp", alt: "LI11 Quchi acupressure point at the elbow", url: "/points/li11-quchi-acupressure-point", location: "Outer end of the elbow crease", tags: ["Allergies", "Skin health", "Immunity"] },
];

const featuredPoints = points.slice(0, 8);

const regions = [
  { label: "Face", url: "/body/face-acupressure-points" },
  { label: "Head", url: "/body/head-acupressure-points" },
  { label: "Neck", url: "/body/neck-acupressure-points" },
  { label: "Shoulders", url: "/body/shoulder-acupressure-points" },
  { label: "Chest", url: "/body/chest-acupressure-points" },
  { label: "Arms & Wrists", url: "/body/arm-wrist-acupressure-points" },
  { label: "Hands", url: "/body/hand-acupressure-chart" },
  { label: "Abdomen", url: "/body/abdomen-acupressure-points" },
  { label: "Back", url: "/body/back-acupressure-points" },
  { label: "Legs", url: "/body/leg-acupressure-points" },
  { label: "Feet", url: "/body/foot-acupressure-points" },
  { label: "Ears", url: "/body/ear-acupressure-points" },
];

const conditions = [
  { title: "Headaches", url: "/conditions/acupressure-for-headache", blurb: "LI4, GB20 and Taiyang for tension and sinus headaches", best: "LI4 · GB20" },
  { title: "Migraines", url: "/conditions/acupressure-for-migraine", blurb: "Points that calm the head and settle migraine nausea", best: "PC6 · GB20" },
  { title: "Neck Pain", url: "/conditions/acupressure-for-neck-pain", blurb: "Release tension held in the neck and shoulders", best: "GB20 · GB21" },
  { title: "Back Pain", url: "/conditions/acupressure-for-back-pain", blurb: "Target the lower back and sciatic pathways", best: "BL40 · BL60 · KD3" },
  { title: "Nausea", url: "/conditions/acupressure-for-nausea", blurb: "The most research-backed use of acupressure", best: "PC6" },
  { title: "Anxiety & Stress", url: "/conditions/acupressure-for-anxiety", blurb: "Calming points for a racing mind and tense body", best: "Yintang · HT7" },
  { title: "Sleep", url: "/conditions/acupressure-for-sleep", blurb: "A nightly routine for falling and staying asleep", best: "HT7 · SP6 · KI1" },
  { title: "Constipation", url: "/conditions/acupressure-for-constipation", blurb: "Support digestive rhythm and abdominal comfort", best: "ST36 · CV6" },
];

const research = [
  { area: "Nausea & vomiting", stat: "Strongest", detail: "The long-running Cochrane systematic review of P6/PC6 stimulation found non-invasive stimulation reduces post-operative nausea and vomiting — the strongest evidence on this site.", source: "Lee & Fan, Cochrane Database Syst Rev 2009" },
  { area: "Pain", stat: "Promising", detail: "Systematic reviews of acupressure for pain, including back, neck, and headache, describe the evidence as promising but limited in quality, with many small or difficult-to-blind trials.", source: "Chen & Wang, 2014" },
  { area: "Anxiety", stat: "Positive", detail: "A systematic review and meta-analysis of acupressure for anxiety found a positive overall direction of effect while calling for more high-quality trials.", source: "Chen HM et al., 2022" },
  { area: "Sleep", stat: "Preliminary", detail: "A randomized controlled trial found acupressure improved sleep quality in nursing-home residents; the wider evidence base is promising but still preliminary.", source: "Liao et al., 2020" },
  { area: "Headache", stat: "Promising", detail: "A randomized trial found one month of acupressure more effective than a muscle relaxant for chronic headache; review evidence is promising but limited in quality.", source: "Hsieh et al., 2010" },
  { area: "Safety", stat: "Low risk", detail: "Acupressure is generally considered low-risk when performed as described on this site; mild, temporary soreness is possible. Serious adverse events in controlled trials are rare.", source: "Across the studies cited on this site" },
];
---

<BaseLayout
  title="Acupressure: 16 Essential Pressure Points"
  description="Evidence-based acupressure guide: what it is, how it works, 16 essential pressure points by body region, condition protocols, clinical research, and safety."
  websiteSchema={true}
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-b from-emerald-50/70 via-white to-white dark:from-emerald-950/20 dark:via-stone-950 dark:to-stone-950">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true" style="background: radial-gradient(55% 60% at 15% 8%, rgba(16,185,129,0.10), transparent 60%), radial-gradient(40% 50% at 90% 90%, rgba(16,185,129,0.08), transparent 60%);"></div>
    <div class="relative z-10 max-w-[1200px] mx-auto px-4 lg:px-6 w-full">
      <div class="grid lg:grid-cols-2 gap-10 items-center py-16 md:py-24">
        <div style="animation: rise 0.7s cubic-bezier(0.16,1,0.3,1) both">
          <p class="text-xs font-semibold uppercase tracking-widest text-emerald-700 dark:text-emerald-400 mb-4">The complete self-care guide</p>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-stone-900 dark:text-stone-50 leading-tight">
            Acupressure — <span class="italic text-emerald-700 dark:text-emerald-400">Ancient Healing,<br />Modern Evidence</span>
          </h1>
          <p class="mt-4 text-base md:text-lg text-stone-600 dark:text-stone-300 leading-relaxed max-w-lg">A drug-free, needle-free Traditional Chinese Medicine technique. Press the right points to relieve pain, nausea, headache, anxiety and poor sleep.</p>
          <div class="mt-8 flex flex-wrap gap-3" style="animation: rise 0.7s cubic-bezier(0.16,1,0.3,1) 120ms both">
            <a href="/atlas" class="inline-flex items-center rounded-lg bg-emerald-700 px-6 py-3 text-sm font-medium text-white transition-all hover:bg-emerald-800 active:scale-[0.98]">Explore the Body Atlas</a>
            <a href="/tools/pain-map" class="inline-flex items-center rounded-lg border border-stone-300 px-6 py-3 text-sm font-medium text-stone-700 transition-all hover:border-emerald-300 hover:text-emerald-700 active:scale-[0.98] dark:border-stone-700 dark:text-stone-300 dark:hover:border-emerald-600 dark:hover:text-emerald-400">Where Does It Hurt?</a>
            <a href="/basics/what-is-acupressure" class="inline-flex items-center rounded-lg border border-stone-300 px-6 py-3 text-sm font-medium text-stone-700 transition-all hover:border-emerald-300 hover:text-emerald-700 active:scale-[0.98] dark:border-stone-700 dark:text-stone-300 dark:hover:border-emerald-600 dark:hover:text-emerald-400">What Is Acupressure?</a>
          </div>
        </div>
        <div class="rounded-2xl border border-stone-200 bg-white p-2 shadow-[0_12px_40px_rgba(28,66,48,0.10)] dark:border-stone-800 dark:bg-stone-900" style="animation: rise 0.7s cubic-bezier(0.16,1,0.3,1) 180ms both">
          <img src="/images/hero-body.webp" alt="Acupressure point locations across the body, from head to feet" width="1672" height="941" fetchpriority="high" class="w-full h-64 sm:h-80 lg:h-[420px] object-cover object-center rounded-xl" />
        </div>
      </div>
    </div>
  </section>

  <!-- Stats bar -->
  <section class="border-y border-stone-200 bg-white dark:border-stone-800 dark:bg-stone-950">
    <div class="max-w-[1200px] mx-auto px-4 lg:px-6 py-10 grid grid-cols-2 lg:grid-cols-4 gap-6 reveal">
      <div>
        <div class="text-3xl font-bold text-emerald-700 dark:text-emerald-400" data-count="16">16</div>
        <div class="mt-1 text-sm text-stone-500 dark:text-stone-400">Essential point guides, each with location photos and technique</div>
      </div>
      <div>
        <div class="text-3xl font-bold text-emerald-700 dark:text-emerald-400" data-count="12">12</div>
        <div class="mt-1 text-sm text-stone-500 dark:text-stone-400">Body regions from head to feet, browsable in the interactive atlas</div>
      </div>
      <div>
        <div class="text-3xl font-bold text-emerald-700 dark:text-emerald-400" data-count="8">8</div>
        <div class="mt-1 text-sm text-stone-500 dark:text-stone-400">Condition-specific step-by-step treatment protocols</div>
      </div>
      <div>
        <div class="text-3xl font-bold text-emerald-700 dark:text-emerald-400" data-count="200" data-suffix="+">200+</div>
        <div class="mt-1 text-sm text-stone-500 dark:text-stone-400">Clinical trials reviewed in our evidence summaries</div>
      </div>
    </div>
  </section>

  <!-- Too many points -> find your two -->
  <section class="relative overflow-hidden">
    <div class="relative">
      <div class="marquee overflow-hidden border-b border-stone-200 py-8 dark:border-stone-800" role="presentation" aria-hidden="true">
        <div class="marquee-track flex w-max items-center will-change-transform" aria-hidden="true">
          {[0, 1].map((copy) => (
            <div key={copy} class="flex shrink-0 items-center gap-8 pr-8">
              {[
                "HEADACHE", "LI4 · Hegu", "NAUSEA", "PC6 · Neiguan", "ANXIETY", "HT7 · Shenmen", "INSOMNIA", "KI1 · Yongquan", "NECK PAIN", "GB21 · Jianjing", "BACK PAIN", "BL40 · Weizhong", "STRESS", "Yintang", "DIGESTION", "ST36 · Zusanli", "MIGRAINE", "GB20 · Fengchi", "TENSION", "LV3 · Taichong", "FATIGUE", "CV6 · Qihai", "SCIATICA", "BL60 · Kunlun", "SLEEP", "SP6 · Sanyinjiao", "CONSTIPATION", "CV17 · Shanzhong"
              ].map((t, i) => (
                <span class={`shrink-0 whitespace-nowrap text-4xl md:text-5xl font-bold tracking-tight uppercase ${i % 2 === 0 ? "text-stone-200 dark:text-stone-800" : "text-emerald-700/50 italic dark:text-emerald-500/50"}`}>{t}</span>
              ))}
            </div>
          ))}
        </div>
      </div>
      <div class="relative z-10 max-w-[1200px] mx-auto px-4 lg:px-6 py-16 md:py-24">
        <div class="max-w-2xl mx-auto text-center" style="animation: rise 0.7s cubic-bezier(0.16,1,0.3,1) both">
          <p class="text-xs font-semibold uppercase tracking-widest text-emerald-700 dark:text-emerald-400 mb-4">16 points. 12 regions. 8 conditions.</p>
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-tight text-stone-900 dark:text-stone-50">Too many points.<br />Find <span class="italic text-emerald-700 dark:text-emerald-400">your</span> two.</h2>
          <p class="mt-4 text-base md:text-lg text-stone-600 dark:text-stone-300 leading-relaxed max-w-xl mx-auto">You don't need the whole map. Start with what you feel — every condition guide narrows it to the two or three points that matter most.</p>
          <div class="mt-8 flex flex-wrap gap-3 justify-center">
            <a href="/conditions" class="inline-flex items-center rounded-lg bg-emerald-700 px-6 py-3 text-sm font-medium text-white transition-all hover:bg-emerald-800 active:scale-[0.98]">Find relief by symptom</a>
            <a href="/atlas" class="inline-flex items-center rounded-lg border border-stone-300 px-6 py-3 text-sm font-medium text-stone-700 transition-all hover:border-emerald-300 hover:text-emerald-700 active:scale-[0.98] dark:border-stone-700 dark:text-stone-300 dark:hover:border-emerald-600 dark:hover:text-emerald-400">Browse points by region</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What is acupressure -->
  <section class="py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-4 lg:px-6">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-stone-900 dark:text-stone-100">What Is Acupressure?</h2>
      <div class="mt-8 grid gap-8 md:grid-cols-2">
        <div>
          <p class="text-stone-600 dark:text-stone-300 leading-relaxed">Acupressure is a therapeutic technique rooted in Traditional Chinese Medicine that applies firm pressure to specific points on the body, known as acupoints. These points lie along energy pathways called meridians, and stimulating them with fingers, thumbs, elbows, or simple tools helps restore balance, relieve pain, and support the body's natural healing.</p>
          <p class="mt-4 text-stone-600 dark:text-stone-300 leading-relaxed">Unlike acupuncture — which inserts thin needles — acupressure works entirely on the surface of the skin. No needles, no prescriptions, no appointments. That makes it one of the safest and most accessible self-care practices available, and it can be learned in minutes.</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="/basics/what-is-acupressure" class="inline-flex items-center rounded-lg bg-emerald-700 px-5 py-2.5 text-sm font-medium text-white transition-all hover:bg-emerald-800 active:scale-[0.98]">Read the Complete Guide</a>
            <a href="/basics/how-does-acupressure-work" class="inline-flex items-center rounded-lg border border-stone-300 px-5 py-2.5 text-sm font-medium text-stone-700 transition-all hover:border-emerald-300 hover:text-emerald-700 active:scale-[0.98] dark:border-stone-700 dark:text-stone-300 dark:hover:border-emerald-600 dark:hover:text-emerald-400">How It Works</a>
          </div>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-stone-200 bg-stone-50 p-5 dark:border-stone-800 dark:bg-stone-900/50">
            <h3 class="font-semibold text-stone-900 dark:text-stone-100">Key facts</h3>
            <ul class="mt-3 space-y-2 text-sm text-stone-600 dark:text-stone-300">
              <li><strong class="text-stone-800 dark:text-stone-200">No needles.</strong> Pressure applied with fingers only — nothing penetrates the skin.</li>
              <li><strong class="text-stone-800 dark:text-stone-200">Self-administered.</strong> You do not need a practitioner to perform acupressure on yourself.</li>
              <li><strong class="text-stone-800 dark:text-stone-200">3,000+ years old.</strong> Roots in TCM healing traditions, now studied in modern clinical trials.</li>
              <li><strong class="text-stone-800 dark:text-stone-200">Recognized.</strong> The WHO recognizes acupressure for pain management and nausea.</li>
            </ul>
          </div>
          <div class="rounded-xl border border-emerald-200/70 bg-emerald-50/60 p-5 dark:border-emerald-900/50 dark:bg-emerald-950/20">
            <h3 class="font-semibold text-stone-900 dark:text-stone-100">The difference from acupuncture</h3>
            <p class="mt-2 text-sm text-stone-600 dark:text-stone-300 leading-relaxed">Acupuncture uses needles inserted by a licensed practitioner. Acupressure applies the same points with finger pressure and works only on the surface. Most people find acupressure ideal for daily self-care between acupuncture sessions.</p>
            <a href="/basics/acupressure-vs-acupuncture" class="mt-3 inline-block text-sm font-medium text-emerald-700 hover:underline dark:text-emerald-400">Acupressure vs acupuncture →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Find relief by symptom -->
  <section class="py-16 md:py-24 bg-white border-y border-stone-200 dark:border-stone-800 dark:bg-stone-950">
    <div class="max-w-[1200px] mx-auto px-4 lg:px-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-stone-900 dark:text-stone-100">Find Relief by <em class="italic text-emerald-700 dark:text-emerald-400">Symptom</em></h2>
          <p class="mt-2 text-stone-500 dark:text-stone-400 max-w-2xl">Start with what you feel. Each protocol lists the exact points, their locations, technique, and a step-by-step routine.</p>
        </div>
        <a href="/conditions" class="text-sm font-medium text-emerald-700 hover:underline dark:text-emerald-400">All condition guides →</a>
      </div>
      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 reveal">
        {conditions.map((c) => (
          <a href={c.url} class="group rounded-xl border border-stone-200 bg-white p-5 transition-all hover:border-emerald-300 hover:shadow-[0_4px_20px_rgba(16,120,87,0.08)] dark:border-stone-800 dark:bg-stone-900 dark:hover:border-emerald-600">
            <h3 class="font-semibold text-stone-900 group-hover:text-emerald-700 dark:text-stone-100 dark:group-hover:text-emerald-400">{c.title}</h3>
            <p class="mt-1.5 text-sm text-stone-500 dark:text-stone-400 leading-relaxed">{c.blurb}</p>
            <p class="mt-3 inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-medium text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400">{c.best} →</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Body atlas -->
  <section class="py-16 md:py-24">
    <div class="max-w-[1200px] mx-auto px-4 lg:px-6">
      <div class="grid lg:grid-cols-2 gap-10 items-start">
        <div>
          <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
              <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-stone-900 dark:text-stone-100">Explore the Body</h2>
              <p class="mt-2 text-stone-500 dark:text-stone-400">Every region has its own point guide — start anywhere.</p>
            </div>
            <a href="/atlas" class="text-sm font-medium text-emerald-700 hover:underline dark:text-emerald-400">Open interactive atlas →</a>
          </div>
          <div class="mt-6 rounded-xl border border-stone-200 bg-stone-50 p-6 dark:border-stone-800 dark:bg-stone-900/50">
            <p class="text-sm text-stone-600 dark:text-stone-300 leading-relaxed">The <a href="/atlas" class="text-emerald-700 hover:underline dark:text-emerald-400">interactive body atlas</a> links every region — head, face, hands, feet and more — to the points that live there. Click or search to jump straight to a point or symptom you care about.</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {regions.map((r) => (
                <a href={r.url} class="rounded-full border border-stone-200 bg-white px-3 py-1.5 text-xs font-medium text-stone-600 transition-colors hover:border-emerald-300 hover:bg-emerald-50 hover:text-emerald-700 dark:border-stone-700 dark:bg-stone-900 dark:text-stone-400 dark:hover:border-emerald-600 dark:hover:text-emerald-400 dark:hover:bg-emerald-900/20">{r.label}</a>
              ))}
            </div>
          </div>
        </div>
        <div class="rounded-xl border border-stone-200 overflow-hidden dark:border-stone-800">
          <img src="/images/hero-body.webp" alt="Acupressure body atlas regions from head to feet" width="1672" height="941" loading="lazy" class="w-full h-56 object-cover object-center" />
          <div class="p-5">
            <h3 class="font-semibold text-stone-900 dark:text-stone-100">From head to feet</h3>
            <p class="mt-1 text-sm text-stone-500 dark:text-stone-400 leading-relaxed">The ears have a full reflex map. The feet hold KI1, the sole point used for grounding and sleep. The back carries the Bladder meridian, the longest channel in the body. Every region links to the points that live there.</p>
            <a href="/atlas" class="mt-3 inline-block rounded-lg bg-emerald-700 px-5 py-2.5 text-sm font-medium text-white transition-all hover:bg-emerald-800 active:scale-[0.98]">Explore the Atlas</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Essential points -->
  <section class="py-16 md:py-24 bg-white border-y border-stone-200 dark:border-stone-800 dark:bg-stone-950">
    <div class="max-w-[1200px] mx-auto px-4 lg:px-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>

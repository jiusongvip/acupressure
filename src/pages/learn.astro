<BaseLayout title="Knowledge Center – Learn Acupressure" description="Everything you need to know about acupressure: fundamentals, condition-specific protocols, techniques, research evidence, and safety guidelines." breadcrumbs={[{ label: "Home", href: "/" }, { label: "Learning Center", href: "/learn" }]}>

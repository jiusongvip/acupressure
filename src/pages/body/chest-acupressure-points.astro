<BaseLayout title="Chest Acupressure Points" description="Explore chest acupressure points including CV17, CV22, and LU1. Learn precise locations, benefits for breathing and emotional health, and stimulation techniques." breadcrumbs={[{ label: "Home", href: "/" }, { label: "Body Atlas", href: "/atlas" }, { label: "Chest", href: "/body/chest-acupressure-points" }]}>

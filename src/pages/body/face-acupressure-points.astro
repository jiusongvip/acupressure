---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Face Acupressure Points" description="Discover facial acupressure points including Yintang, Taiyang, and LI20. Learn how to relieve sinus pressure, headaches, and eye strain with targeted point stimulation." breadcrumbs={[{ label: "Home", href: "/" }, { label: "Body Atlas", href: "/atlas/" }, { label: "Face", href: "/body/face-acupressure-points/" }]}>

<BaseLayout title="Hand Acupressure Points &amp; Chart" description="Discover hand acupressure points with our interactive chart. Explore LI4, HT7, PC6, and more with precise locations, benefits, and step-by-step stimulation guides." breadcrumbs={[{ label: "Home", href: "/" }, { label: "Body Atlas", href: "/atlas/" }, { label: "Hand", href: "/body/hand-acupressure-chart/" }]}>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Abdomen Acupressure Points" description="Browse acupressure points on the abdomen. Find guides for CV6, CV12, ST25, and more." breadcrumbs={[{ label: "Home", href: "/" }, { label: "Body Atlas", href: "/atlas/" }, { label: "Abdomen", href: "/body/abdomen-acupressure-points/" }]}>
<div class="max-w-4xl mx-auto px-4 py-12 lg:px-6"><div class="text-center mb-10"><span class="text-xs font-semibold uppercase tracking-widest text-emerald-600 dark:text-emerald-400">Body Region</span><h1 class="text-3xl md:text-4xl font-bold tracking-tight text-stone-900 dark:text-stone-100 mt-2">Abdomen</h1><p class="text-stone-500 dark:text-stone-400 mt-2">Acupressure points on the abdomen for digestive health and core vitality.</p></div><div class="mb-10 flex justify-center"><svg viewBox="0 0 100 130" xmlns="http://www.w3.org/2000/svg" class="w-28 h-32"><path d="M20 5 Q50 0 80 5 L85 95 Q50 105 15 95 Z" fill="rgba(45,106,79,0.06)" stroke="#2d6a4f" stroke-width="1.5"></path><circle cx="50" cy="20" r="2" fill="#2d6a4f" opacity="0.5"></circle><circle cx="50" cy="45" r="2" fill="#2d6a4f" opacity="0.5"></circle><circle cx="35" cy="60" r="2" fill="#2d6a4f" opacity="0.5"></circle><circle cx="65" cy="60" r="2" fill="#2d6a4f" opacity="0.5"></circle><circle cx="50" cy="80" r="2" fill="#2d6a4f" opacity="0.5"></circle><text x="50" y="122" font-family="system-ui" font-size="10" fill="#2d6a4f" text-anchor="middle" font-weight="600">Abdomen</text></svg></div><div class="space-y-3"><a href="/points/cv6-qihai-acupressure-point/" class="group flex items-center gap-4 rounded-xl border border-stone-200 bg-white p-5 transition-all hover:border-emerald-400 hover:shadow-sm dark:border-stone-700 dark:bg-stone-900 dark:hover:border-emerald-600"><div class="shrink-0 w-12 h-12 rounded-lg bg-emerald-100 dark:bg-emerald-900/40 flex items-center justify-center text-emerald-700 dark:text-emerald-400 text-sm font-bold">CV6</div><div class="flex-1 min-w-0"><h3 class="font-semibold text-stone-900 dark:text-stone-100">CV6 (Qihai)<span class="text-xs text-stone-400 dark:text-stone-500 font-normal"> · Sea of Qi</span></h3><div class="text-yellow-500 text-xs mt-0.5">★★★★★</div><p class="text-sm text-stone-500 dark:text-stone-400 mt-0.5">Fatigue, digestive weakness, vitality</p></div><span class="text-sm text-emerald-600 dark:text-emerald-400 opacity-0 group-hover:opacity-100 transition-opacity shrink-0">Learn More →</span></a><a href="/points/acupressure-points/" class="group flex items-center gap-4 rounded-xl border border-stone-200 bg-white p-5 transition-all hover:border-emerald-400 hover:shadow-sm dark:border-stone-700 dark:bg-stone-900 dark:hover:border-emerald-600"><div class="shrink-0 w-12 h-12 rounded-lg bg-emerald-100 dark:bg-emerald-900/40 flex items-center justify-center text-emerald-700 dark:text-emerald-400 text-sm font-bold">CV4</div><div class="flex-1 min-w-0"><h3 class="font-semibold text-stone-900 dark:text-stone-100">CV4 (Guanyuan)<span class="text-xs text-stone-400 dark:text-stone-500 font-normal"> · Gate of Origin</span></h3><div class="text-yellow-500 text-xs mt-0.5">★★★★★</div><p class="text-sm text-stone-500 dark:text-stone-400 mt-0.5">Urinary issues, reproductive health</p></div><span class="text-sm text-emerald-600 dark:text-emerald-400 opacity-0 group-hover:opacity-100 transition-opacity shrink-0">Learn More →</span></a><a href="/points/acupressure-points/" class="group flex items-center gap-4 rounded-xl border border-stone-200 bg-white p-5 transition-all hover:border-emerald-400 hover:shadow-sm dark:border-stone-700 dark:bg-stone-900 dark:hover:border-emerald-600"><div class="shrink-0 w-12 h-12 rounded-lg bg-emerald-100 dark:bg-emerald-900/40 flex items-center justify-center text-emerald-700 dark:text-emerald-400 text-sm font-bold">CV12</div><div class="flex-1 min-w-0"><h3 class="font-semibold text-stone-900 dark:text-stone-100">CV12 (Zhongwan)<span class="text-xs text-stone-400 dark:text-stone-500 font-normal"> · Middle Cavity</span></h3><div class="text-yellow-500 text-xs mt-0.5">★★★★★</div><p class="text-sm text-stone-500 dark:text-stone-400 mt-0.5">Indigestion, bloating, nausea</p></div><span class="text-sm text-emerald-600 dark:text-emerald-400 opacity-0 group-hover:opacity-100 transition-opacity shrink-0">Learn More →</span></a><a href="/points/acupressure-points/" class="group flex items-center gap-4 rounded-xl border border-stone-200 bg-white p-5 transition-all hover:border-emerald-400 hover:shadow-sm dark:border-stone-700 dark:bg-stone-900 dark:hover:border-emerald-600"><div class="shrink-0 w-12 h-12 rounded-lg bg-emerald-100 dark:bg-emerald-900/40 flex items-center justify-center text-emerald-700 dark:text-emerald-400 text-sm font-bold">ST25</div><div class="flex-1 min-w-0"><h3 class="font-semibold text-stone-900 dark:text-stone-100">ST25 (Tianshu)<span class="text-xs text-stone-400 dark:text-stone-500 font-normal"> · Celestial Pivot</span></h3><div class="text-yellow-500 text-xs mt-0.5">★★★★★</div><p class="text-sm text-stone-500 dark:text-stone-400 mt-0.5">Constipation, diarrhea, bloating</p></div><span class="text-sm text-emerald-600 dark:text-emerald-400 opacity-0 group-hover:opacity-100 transition-opacity shrink-0">Learn More →</span></a><a href="/points/acupressure-points/" class="group flex items-center gap-4 rounded-xl border border-stone-200 bg-white p-5 transition-all hover:border-emerald-400 hover:shadow-sm dark:border-stone-700 dark:bg-stone-900 dark:hover:border-emerald-600"><div class="shrink-0 w-12 h-12 rounded-lg bg-emerald-100 dark:bg-emerald-900/40 flex items-center justify-center text-emerald-700 dark:text-emerald-400 text-sm font-bold">ST29</div><div class="flex-1 min-w-0"><h3 class="font-semibold text-stone-900 dark:text-stone-100">ST29 (Guilai)<span class="text-xs text-stone-400 dark:text-stone-500 font-normal"> · Return</span></h3><div class="text-yellow-500 text-xs mt-0.5">★★★☆☆</div><p class="text-sm text-stone-500 dark:text-stone-400 mt-0.5">Menstrual cramps, lower abdominal pain</p></div><span class="text-sm text-emerald-600 dark:text-emerald-400 opacity-0 group-hover:opacity-100 transition-opacity shrink-0">Learn More →</span></a></div><div class="text-center mt-10"><a href="/atlas/" class="inline-flex items-center gap-1 text-sm text-stone-500 hover:text-emerald-600 dark:text-stone-400 dark:hover:text-emerald-400">← Back to Body Atlas</a></div></div>
</BaseLayout>
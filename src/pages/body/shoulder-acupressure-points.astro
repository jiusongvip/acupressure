---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Shoulder Acupressure Points" description="Discover shoulder acupressure points including GB21, LI15, and SI9. Learn how to release shoulder tension, improve mobility, and relieve pain with point stimulation guides." breadcrumbs={[{ label: "Home", href: "/" }, { label: "Body Atlas", href: "/atlas" }, { label: "Shoulder", href: "/body/shoulder-acupressure-points" }]}>

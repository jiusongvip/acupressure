---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Body Areas – Acupressure Points by Region" description="Browse acupressure points organized by body region. Explore detailed guides for points on the head, face, hands, feet, back, and limbs with location maps and benefits." breadcrumbs={[{ label: "Home", href: "/" }, { label: "Body Atlas", href: "/atlas/" }, { label: "Body Regions", href: "/body/" }]} articleSchema={true}>

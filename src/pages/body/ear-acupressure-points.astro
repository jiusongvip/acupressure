---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Ear Acupressure Points" description="Explore auricular ear acupressure points including Shenmen and Zero Point. Learn how ear reflexology works, key point locations, and benefits for pain and stress." breadcrumbs={[{ label: "Home", href: "/" }, { label: "Body Atlas", href: "/atlas" }, { label: "Ear", href: "/body/ear-acupressure-points" }]}>
<div class="max-w-4xl mx-auto px-4 py-12 lg:px-6"><div class="text-center mb-10"><span class="text-xs font-semibold uppercase tracking-widest text-emerald-600 dark:text-emerald-400">Body Region</span><h1 class="text-3xl md:text-4xl font-bold tracking-tight text-stone-900 dark:text-stone-100 mt-2">Ear</h1><p class="text-stone-500 dark:text-stone-400 mt-2">Auricular (ear) acupressure points a complete microsystem for whole-body wellness.</p></div><div class="mb-10 flex justify-center"><svg viewBox="0 0 100 120" xmlns="http://www.w3.org/2000/svg" class="w-32 h-36"><ellipse cx="50" cy="50" rx="20" ry="30" fill="rgba(45,106,79,0.06)" stroke="#2d6a4f" stroke-width="1.5"></ellipse><ellipse cx="50" cy="48" rx="10" ry="18" fill="none" stroke="#2d6a4f" stroke-width="0.8" opacity="0.4"></ellipse><circle cx="50" cy="38" r="2" fill="#2d6a4f" opacity="0.5"></circle><circle cx="50" cy="50" r="2" fill="#2d6a4f" opacity="0.5"></circle><circle cx="50" cy="62" r="2" fill="#2d6a4f" opacity="0.5"></circle><text x="50" y="105" font-family="system-ui" font-size="10" fill="#2d6a4f" text-anchor="middle" font-weight="600">Ear</text></svg></div><div class="space-y-3"><a href="/points/acupressure-points" class="group flex items-center gap-4 rounded-xl border border-stone-200 bg-white p-5 transition-all hover:border-emerald-400 hover:shadow-sm dark:border-stone-700 dark:bg-stone-900 dark:hover:border-emerald-600"><div class="shrink-0 w-12 h-12 rounded-lg bg-emerald-100 dark:bg-emerald-900/40 flex items-center justify-center text-emerald-700 dark:text-emerald-400 text-sm font-bold">Shenmen</div><div class="flex-1 min-w-0"><h3 class="font-semibold text-stone-900 dark:text-stone-100">Shenmen (Spirit Gate)</h3><div class="text-yellow-500 text-xs mt-0.5">★★★★★</div><p class="text-sm text-stone-500 dark:text-stone-400 mt-0.5">Anxiety, pain, addiction, insomnia</p></div><span class="text-sm text-emerald-600 dark:text-emerald-400 opacity-0 group-hover:opacity-100 transition-opacity shrink-0">Learn More →</span></a><a href="/points/acupressure-points" class="group flex items-center gap-4 rounded-xl border border-stone-200 bg-white p-5 transition-all hover:border-emerald-400 hover:shadow-sm dark:border-stone-700 dark:bg-stone-900 dark:hover:border-emerald-600"><div class="shrink-0 w-12 h-12 rounded-lg bg-emerald-100 dark:bg-emerald-900/40 flex items-center justify-center text-emerald-700 dark:text-emerald-400 text-sm font-bold">Zero</div><div class="flex-1 min-w-0"><h3 class="font-semibold text-stone-900 dark:text-stone-100">Zero Point</h3><div class="text-yellow-500 text-xs mt-0.5">★★★★★</div><p class="text-sm text-stone-500 dark:text-stone-400 mt-0.5">Pain management, overall relaxation</p></div><span class="text-sm text-emerald-600 dark:text-emerald-400 opacity-0 group-hover:opacity-100 transition-opacity shrink-0">Learn More →</span></a><a href="/points/acupressure-points" class="group flex items-center gap-4 rounded-xl border border-stone-200 bg-white p-5 transition-all hover:border-emerald-400 hover:shadow-sm dark:border-stone-700 dark:bg-stone-900 dark:hover:border-emerald-600"><div class="shrink-0 w-12 h-12 rounded-lg bg-emerald-100 dark:bg-emerald-900/40 flex items-center justify-center text-emerald-700 dark:text-emerald-400 text-sm font-bold">Eye</div><div class="flex-1 min-w-0"><h3 class="font-semibold text-stone-900 dark:text-stone-100">Eye Point</h3><div class="text-yellow-500 text-xs mt-0.5">★★★★★</div><p class="text-sm text-stone-500 dark:text-stone-400 mt-0.5">Eye strain, vision fatigue</p></div><span class="text-sm text-emerald-600 dark:text-emerald-400 opacity-0 group-hover:opacity-100 transition-opacity shrink-0">Learn More →</span></a><a href="/points/acupressure-points" class="group flex items-center gap-4 rounded-xl border border-stone-200 bg-white p-5 transition-all hover:border-emerald-400 hover:shadow-sm dark:border-stone-700 dark:bg-stone-900 dark:hover:border-emerald-600"><div class="shrink-0 w-12 h-12 rounded-lg bg-emerald-100 dark:bg-emerald-900/40 flex items-center justify-center text-emerald-700 dark:text-emerald-400 text-sm font-bold">Master</div><div class="flex-1 min-w-0"><h3 class="font-semibold text-stone-900 dark:text-stone-100">Master Cerebral</h3><div class="text-yellow-500 text-xs mt-0.5">★★★☆</div><p class="text-sm text-stone-500 dark:text-stone-400 mt-0.5">Headaches, concentration, memory</p></div><span class="text-sm text-emerald-600 dark:text-emerald-400 opacity-0 group-hover:opacity-100 transition-opacity shrink-0">Learn More →</span></a><a href="/points/acupressure-points" class="group flex items-center gap-4 rounded-xl border border-stone-200 bg-white p-5 transition-all hover:border-emerald-400 hover:shadow-sm dark:border-stone-700 dark:bg-stone-900 dark:hover:border-emerald-600"><div class="shrink-0 w-12 h-12 rounded-lg bg-emerald-100 dark:bg-emerald-900/40 flex items-center justify-center text-emerald-700 dark:text-emerald-400 text-sm font-bold">Hunger</div><div class="flex-1 min-w-0"><h3 class="font-semibold text-stone-900 dark:text-stone-100">Hunger Point</h3><div class="text-yellow-500 text-xs mt-0.5">★★★☆</div><p class="text-sm text-stone-500 dark:text-stone-400 mt-0.5">Appetite control, cravings</p></div><span class="text-sm text-emerald-600 dark:text-emerald-400 opacity-0 group-hover:opacity-100 transition-opacity shrink-0">Learn More →</span></a></div><div class="text-center mt-10"><a href="/atlas" class="inline-flex items-center gap-1 text-sm text-stone-500 hover:text-emerald-600 dark:text-stone-400 dark:hover:text-emerald-400">Back to Body Atlas</a></div></div>

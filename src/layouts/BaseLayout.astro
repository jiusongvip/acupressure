---
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  breadcrumbs?: { label: string; href: string }[];
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  articleSchema?: boolean;
  websiteSchema?: boolean;
  datePublished?: string;
  dateModified?: string;
  ogImage?: string;
}

const { title, description, breadcrumbs, noindex, schema, articleSchema, websiteSchema, datePublished, dateModified, ogImage } = Astro.props;
const canonicalUrl = `https://www.acupressureguide.com${Astro.url.pathname}`;
const ogImageUrl = ogImage || "https://www.acupressureguide.com/og-default.svg";
const year = new Date().getFullYear();

const breadcrumbSchema = breadcrumbs?.length ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((bc, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": bc.label,
    "item": `https://www.acupressureguide.com${bc.href}`
  }))
} : null;

const websiteSchemaObj = websiteSchema ? {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Acupressure Guide",
  "url": "https://www.acupressureguide.com",
  "description": "Evidence-based guide to acupressure points, techniques, and health benefits.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://www.acupressureguide.com/?s={search_term_string}",
    "query-input": "required name=search_term_string"
  }
} : null;

const articleSchemaObj = articleSchema ? {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "url": canonicalUrl,
  "datePublished": datePublished || "2025-01-15",
  "dateModified": dateModified || "2026-06-01",
  "author": {
    "@type": "Person",
    "name": "Dr. Chen Wei, TCM Practitioner",
    "url": "https://www.acupressureguide.com/about/",
    "knowsAbout": "Traditional Chinese Medicine, Acupressure, Acupuncture",
    "hasCredential": "Doctorate in Acupuncture and Oriental Medicine"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Acupressure Guide",
    "url": "https://www.acupressureguide.com",
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.acupressureguide.com/logo.png"
    }
  },
  "image": {
    "@type": "ImageObject",
    "url": ogImageUrl
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  }
} : null;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Acupressure Guide</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={`${title} | Acupressure Guide`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Acupressure Guide`} />
    <meta name="twitter:description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Acupressure Guide",
        "url": "https://www.acupressureguide.com",
        "logo": "https://www.acupressureguide.com/logo.png"
      }
    </script>
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>}
    {websiteSchemaObj && <script type="application/ld+json" set:html={JSON.stringify(websiteSchemaObj)}></script>}
    {articleSchemaObj && <script type="application/ld+json" set:html={JSON.stringify(articleSchemaObj)}></script>}
    {schema && <script type="application/ld+json" set:html={JSON.stringify(Array.isArray(schema) ? schema : [schema])}></script>}
  </head>
  <body>
    <nav class="sticky top-0 z-50 border-b border-stone-200 bg-white/95 backdrop-blur-sm dark:border-stone-800 dark:bg-stone-950/95">
      <div class="mx-auto flex h-16 max-w-[1200px] items-center justify-between px-4 lg:px-6">
        <a href="/" class="inline-flex items-center gap-2 no-underline hover:opacity-80 transition-opacity" aria-label="Acupressure Guide home">
          <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="18" cy="18" r="16" stroke="#2d6a4f" stroke-width="2" fill="rgba(45,106,79,0.08)"></circle>
            <circle cx="18" cy="18" r="4" fill="#2d6a4f"></circle>
            <circle cx="18" cy="18" r="10" stroke="#2d6a4f" stroke-width="1.5" stroke-dasharray="3,3" fill="none"></circle>
            <circle cx="8" cy="12" r="2.5" fill="#2d6a4f" opacity="0.6"></circle>
            <circle cx="28" cy="12" r="2.5" fill="#2d6a4f" opacity="0.6"></circle>
            <circle cx="8" cy="24" r="2.5" fill="#2d6a4f" opacity="0.6"></circle>
            <circle cx="28" cy="24" r="2.5" fill="#2d6a4f" opacity="0.6"></circle>
            <circle cx="12" cy="7" r="1.8" fill="#2d6a4f" opacity="0.4"></circle>
            <circle cx="24" cy="7" r="1.8" fill="#2d6a4f" opacity="0.4"></circle>
            <circle cx="12" cy="29" r="1.8" fill="#2d6a4f" opacity="0.4"></circle>
            <circle cx="24" cy="29" r="1.8" fill="#2d6a4f" opacity="0.4"></circle>
          </svg>
          <span class="font-semibold text-stone-800 dark:text-stone-200 text-lg tracking-tight">Acupressure Guide</span>
        </a>
        <div class="hidden items-center gap-6 lg:gap-8 md:flex">
          <a href="/" class="text-sm font-medium text-stone-600 transition-colors hover:text-emerald-500 dark:text-stone-400 dark:hover:text-emerald-400">Home</a>
          <div class="relative group">
            <button class="text-sm font-medium text-stone-600 transition-colors hover:text-emerald-500 dark:text-stone-400 dark:hover:text-emerald-400 cursor-pointer flex items-center gap-1">Guides <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></button>
            <div class="absolute top-full left-0 mt-1 w-48 rounded-lg border border-stone-200 bg-white shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all dark:border-stone-700 dark:bg-stone-900 z-50">
              <a href="/basics" class="block px-4 py-2 text-sm text-stone-600 hover:bg-emerald-50 hover:text-emerald-600 dark:text-stone-400 dark:hover:bg-emerald-900/20 dark:hover:text-emerald-400 rounded-t-lg">Basics</a>
              <a href="/techniques" class="block px-4 py-2 text-sm text-stone-600 hover:bg-emerald-50 hover:text-emerald-600 dark:text-stone-400 dark:hover:bg-emerald-900/20 dark:hover:text-emerald-400">Techniques</a>
              <a href="/conditions" class="block px-4 py-2 text-sm text-stone-600 hover:bg-emerald-50 hover:text-emerald-600 dark:text-stone-400 dark:hover:bg-emerald-900/20 dark:hover:text-emerald-400">Conditions</a>
              <a href="/body" class="block px-4 py-2 text-sm text-stone-600 hover:bg-emerald-50 hover:text-emerald-600 dark:text-stone-400 dark:hover:bg-emerald-900/20 dark:hover:text-emerald-400">Body Regions</a>
              <a href="/safety" class="block px-4 py-2 text-sm text-stone-600 hover:bg-emerald-50 hover:text-emerald-600 dark:text-stone-400 dark:hover:bg-emerald-900/20 dark:hover:text-emerald-400">Safety</a>
              <a href="/research" class="block px-4 py-2 text-sm text-stone-600 hover:bg-emerald-50 hover:text-emerald-600 dark:text-stone-400 dark:hover:bg-emerald-900/20 dark:hover:text-emerald-400">Research</a>
              <a href="/products" class="block px-4 py-2 text-sm text-stone-600 hover:bg-emerald-50 hover:text-emerald-600 dark:text-stone-400 dark:hover:bg-emerald-900/20 dark:hover:text-emerald-400 rounded-b-lg">Products</a>
            </div>
          </div>
          <a href="/atlas" class="text-sm font-medium text-stone-600 transition-colors hover:text-emerald-500 dark:text-stone-400 dark:hover:text-emerald-400">Points Atlas</a>
          <a href="/learn" class="text-sm font-medium text-stone-600 transition-colors hover:text-emerald-500 dark:text-stone-400 dark:hover:text-emerald-400">Learning Center</a>
          <a href="/about" class="text-sm font-medium text-stone-600 transition-colors hover:text-emerald-500 dark:text-stone-400 dark:hover:text-emerald-400">About</a>
        </div>
        <button class="flex items-center gap-2 text-sm text-stone-600 md:hidden dark:text-stone-400" aria-label="Toggle navigation" aria-controls="mobile-nav" aria-expanded="false" id="nav-toggle">Menu</button>
      </div>
      <div id="mobile-nav" class="hidden border-t border-stone-200 px-4 pb-4 dark:border-stone-800" role="navigation" aria-label="Mobile navigation">
        <a href="/" class="block py-2 text-sm text-stone-600 dark:text-stone-400">Home</a>
        <div class="py-2 border-b border-stone-100 dark:border-stone-800">
          <span class="text-xs font-semibold uppercase tracking-widest text-stone-400">Guides</span>
          <div class="mt-1 grid grid-cols-2 gap-1">
            <a href="/basics" class="block py-1.5 text-sm text-stone-600 dark:text-stone-400">Basics</a>
            <a href="/techniques" class="block py-1.5 text-sm text-stone-600 dark:text-stone-400">Techniques</a>
            <a href="/conditions" class="block py-1.5 text-sm text-stone-600 dark:text-stone-400">Conditions</a>
            <a href="/body" class="block py-1.5 text-sm text-stone-600 dark:text-stone-400">Body Regions</a>
            <a href="/safety" class="block py-1.5 text-sm text-stone-600 dark:text-stone-400">Safety</a>
            <a href="/research" class="block py-1.5 text-sm text-stone-600 dark:text-stone-400">Research</a>
            <a href="/products" class="block py-1.5 text-sm text-stone-600 dark:text-stone-400">Products</a>
          </div>
        </div>
        <a href="/history" class="block py-2 text-sm text-stone-600 dark:text-stone-400">History</a>
        <a href="/atlas" class="block py-2 text-sm text-stone-600 dark:text-stone-400">Points Atlas</a>
        <a href="/learn" class="block py-2 text-sm text-stone-600 dark:text-stone-400">Learning Center</a>
        <a href="/about" class="block py-2 text-sm text-stone-600 dark:text-stone-400">About</a>
      </div>
    </nav>
    <script is:inline>
      var toggle = document.getElementById('nav-toggle');
      var mobileNav = document.getElementById('mobile-nav');
      if (toggle && mobileNav) {
        toggle.addEventListener('click', function () {
          var expanded = mobileNav.classList.toggle('hidden');
          toggle.setAttribute('aria-expanded', String(!expanded));
        });
      }
    </script>

    <main class="flex-1">
      {breadcrumbs && breadcrumbs.length > 0 && (
        <nav aria-label="Breadcrumb" class="mx-auto max-w-[1200px] px-4 pt-4 lg:px-6">
          <ol class="flex flex-wrap items-center gap-1.5 text-xs text-stone-400 dark:text-stone-500">
            {breadcrumbs.map((bc, i) => (
              <li class="flex items-center gap-1.5">
                {i > 0 && <span aria-hidden="true">/</span>}
                {i === breadcrumbs.length - 1 ? (
                  <span class="text-stone-600 dark:text-stone-300 font-medium">{bc.label}</span>
                ) : (
                  <a href={bc.href} class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">{bc.label}</a>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )}
      <slot />
    </main>

    <footer class="border-t border-stone-200 bg-stone-100 dark:border-stone-800 dark:bg-stone-900">
      <div class="mx-auto max-w-[1200px] px-4 py-12 lg:px-6">
        <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
          <div class="col-span-2 md:col-span-1">
            <a href="/" class="text-lg font-semibold tracking-tight text-stone-900 dark:text-stone-100">Acupressure<span class="text-emerald-600 dark:text-emerald-400">Guide</span></a>
            <p class="mt-2 text-sm text-stone-500 dark:text-stone-400 max-w-[30ch]">Traditional healing explained through modern knowledge and scientific evidence.</p>
          </div>
          <div>
            <h4 class="mb-3 text-xs font-semibold uppercase tracking-widest text-stone-500 dark:text-stone-400">Explore</h4>
            <ul class="space-y-2">
              <li><a href="/" class="text-sm text-stone-600 transition-colors hover:text-emerald-600 dark:text-stone-400 dark:hover:text-emerald-400">Home</a></li>
              <li><a href="/basics" class="text-sm text-stone-600 transition-colors hover:text-emerald-600 dark:text-stone-400 dark:hover:text-emerald-400">Basics</a></li>
              <li><a href="/techniques" class="text-sm text-stone-600 transition-colors hover:text-emerald-600 dark:text-stone-400 dark:hover:text-emerald-400">Techniques</a></li>
              <li><a href="/conditions" class="text-sm text-stone-600 transition-colors hover:text-emerald-600 dark:text-stone-400 dark:hover:text-emerald-400">Conditions</a></li>
              <li><a href="/body" class="text-sm text-stone-600 transition-colors hover:text-emerald-600 dark:text-stone-400 dark:hover:text-emerald-400">Body Regions</a></li>
              <li><a href="/research" class="text-sm text-stone-600 transition-colors hover:text-emerald-600 dark:text-stone-400 dark:hover:text-emerald-400">Research</a></li>
              <li><a href="/safety" class="text-sm text-stone-600 transition-colors hover:text-emerald-600 dark:text-stone-400 dark:hover:text-emerald-400">Safety</a></li>
              <li><a href="/products" class="text-sm text-stone-600 transition-colors hover:text-emerald-600 dark:text-stone-400 dark:hover:text-emerald-400">Products</a></li>
            </ul>
          </div>
          <div>
            <h4 class="mb-3 text-xs font-semibold uppercase tracking-widest text-stone-500 dark:text-stone-400">Learn</h4>
            <ul class="space-y-2">
              <li><a href="/atlas" class="text-sm text-stone-600 transition-colors hover:text-emerald-600 dark:text-stone-400 dark:hover:text-emerald-400">Points Atlas</a></li>
              <li><a href="/history" class="text-sm text-stone-600 transition-colors hover:text-emerald-600 dark:text-stone-400 dark:hover:text-emerald-400">History</a></li>
              <li><a href="/learn" class="text-sm text-stone-600 transition-colors hover:text-emerald-600 dark:text-stone-400 dark:hover:text-emerald-400">Learning Center</a></li>
              <li><a href="/about" class="text-sm text-stone-600 transition-colors hover:text-emerald-600 dark:text-stone-400 dark:hover:text-emerald-400">About</a></li>
            </ul>
          </div>
          <div>
            <h4 class="mb-3 text-xs font-semibold uppercase tracking-widest text-stone-500 dark:text-stone-400">Support</h4>
            <ul class="space-y-2">
              <li><a href="/contact" class="text-sm text-stone-600 transition-colors hover:text-emerald-600 dark:text-stone-400 dark:hover:text-emerald-400">Contact</a></li>
              <li><a href="/privacy-policy" class="text-sm text-stone-600 transition-colors hover:text-emerald-600 dark:text-stone-400 dark:hover:text-emerald-400">Privacy</a></li>
              <li><a href="/about/#disclaimer" class="text-sm text-stone-600 transition-colors hover:text-emerald-600 dark:text-stone-400 dark:hover:text-emerald-400">Disclaimer</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-10 border-t border-stone-200 pt-6 dark:border-stone-800">
          <p class="text-xs text-stone-500 dark:text-stone-500">&copy; {year} Acupressure Guide. Content is for informational purposes only and does not constitute medical advice.</p>
          <p class="mt-2 text-xs text-stone-400 dark:text-stone-500">Historical acupuncture charts sourced from <a href="https://wellcomecollection.org/" class="underline hover:text-emerald-600 dark:hover:text-emerald-400" target="_blank" rel="noopener">Wellcome Collection</a>, CC-BY 4.0.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
